# ─── Django ───────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=wagadu.settings.prod
DJANGO_SECRET_KEY=change-me-generate-a-50-char-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=hub.wagadu.africa,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://hub.wagadu.africa
DJANGO_TIME_ZONE=Africa/Dakar
DJANGO_LOG_LEVEL=INFO

# ─── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_DB=wagadu
POSTGRES_USER=wagadu
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis / Celery ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO (S3) ───────────────────────────────────────────────────────
MINIO_ROOT_USER=wagadu
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=wagadu
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=wagadu-hub
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_USE_SSL=0

# ─── E-mail (SMTP) ────────────────────────────────────────────────────
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=wagadu-hub@wagadu.africa

# ─── CORS / Frontend ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://hub.wagadu.africa
NEXT_PUBLIC_API_BASE_URL=/api/v1
